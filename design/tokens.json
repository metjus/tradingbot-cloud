{
  "$schema": "argus-design-tokens",
  "product": {
    "name": "ARGUS",
    "tagline": "Autonomous Trading Intelligence"
  },
  "color": {
    "bg": { "base": "#0B0E15", "panel": "#11151F", "inset": "#141A28", "raised": "#171C2A" },
    "line": { "default": "#242C40", "subtle": "#1B2130", "strong": "#2E3850" },
    "text": { "primary": "#E8EDF7", "secondary": "#98A2B8", "muted": "#5E6880", "soft": "#C6CEDE" },
    "accent": { "blue": "#5B8CFF", "violet": "#8F7BFF", "gradient": "linear-gradient(135deg, #5B8CFF, #8F7BFF)" },
    "semantic": { "profit": "#35D49B", "loss": "#F6567A", "warning": "#F0B13F" }
  },
  "font": {
    "display": "'Space Grotesk', sans-serif",
    "ui": "'Inter', sans-serif",
    "mono": "'JetBrains Mono', monospace"
  },
  "radius": { "chip": 7, "control": 10, "card": 12, "panel": 14, "hero": 18, "pill": 999 },
  "spacing": [4, 8, 12, 16, 24, 32],
  "rules": {
    "noEmoji": true,
    "plGetsSignAndColor": true,
    "transitionsMs": [150, 200],
    "sectionLabel": { "sizePx": 11, "transform": "uppercase", "letterSpacingPx": 1.5, "color": "text.muted" }
  }
}
